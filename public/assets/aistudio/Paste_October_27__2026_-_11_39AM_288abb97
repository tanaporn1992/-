  <!-- APPLICATION SCRIPT -->
  <script>
    // Building Configurations & Exact Ranges according to prompt
    const BUILDINGS_CONFIG = [
      {
        id: 'thachana',
        name: 'ท่าชนะ',
        ranges: '101-110,201-210,301-310,401-410',
        waterType: 'unit',
        waterRate: 20
      },
      {
        id: 'thaphet',
        name: 'ท่าเพชร',
        ranges: '101,201-224,301-324,401-424,501-524',
        waterType: 'unit',
        waterRate: 20
      },
      {
        id: 'thathong',
        name: 'ท่าทอง',
        ranges: '101,201-224,301-324,401-424,501-524',
        waterType: 'unit',
        waterRate: 20
      },
      {
        id: 'prapassorn',
        name: 'ประภัสสร',
        groups: [
          {
            ranges: '4114,4201,4202,4301,4302,4401,4402,4501,4502',
            waterType: 'unit',
            waterRate: 20,
            note: 'คิดตามหน่วย 20 บ./หน่วย'
          },
          {
            ranges: '4303-4317,4403-4417,4503-4517',
            waterType: 'flat_per_person',
            waterRate: 100,
            note: 'เหมา 100 บ./คน'
          }
        ]
      },
      {
        id: 'ratchaprapha',
        name: 'รัชประภา',
        ranges: '101-110,201-210,301-310,401-410',
        waterType: 'unit',
        waterRate: 20
      },
      {
        id: 'wiphawadi',
        name: 'วิภาวดี',
        ranges: '1101-1107,1201-1209,1301-1309,1401-1402',
        waterType: 'unit',
        waterRate: 20
      },
      {
        id: 'chaiya',
        name: 'ไชยา',
        ranges: '2101-2107,2201-2209,2301-2309,2401-2402',
        waterType: 'unit',
        waterRate: 20
      }
    ];

    // Helper to parse numeric room ranges
    function parseRanges(rangeStr) {
      const rooms = [];
      const parts = rangeStr.split(',').map(s => s.trim());
      parts.forEach(p => {
        if (p.includes('-')) {
          const [start, end] = p.split('-').map(n => parseInt(n.trim(), 10));
          for (let i = start; i <= end; i++) {
            rooms.push(i.toString());
          }
        } else if (p) {
          rooms.push(p);
        }
      });
      return rooms;
    }

    // Helper to extract floor number from room string
    function extractFloor(roomNo) {
      const num = parseInt(roomNo, 10);
      if (num >= 4000) return Math.floor((num - 4000) / 100);
      if (num >= 2000) return Math.floor((num - 2000) / 100);
      if (num >= 1000) return Math.floor((num - 1000) / 100);
      if (num >= 100) return Math.floor(num / 100);
      return 1;
    }

    // Build Master Room List
    function generateMasterRooms() {
      const allRooms = [];
      
      BUILDINGS_CONFIG.forEach(b => {
        if (b.groups) {
          b.groups.forEach(g => {
            const roomNos = parseRanges(g.ranges);
            roomNos.forEach(rNo => {
              allRooms.push({
                id: `${b.id}_${rNo}`,
                buildingId: b.id,
                buildingName: b.name,
                roomNo: rNo,
                floor: extractFloor(rNo),
                waterType: g.waterType,
                waterRate: g.waterRate,
                waterNote: g.note
              });
            });
          });
        } else {
          const roomNos = parseRanges(b.ranges);
          roomNos.forEach(rNo => {
            allRooms.push({
              id: `${b.id}_${rNo}`,
              buildingId: b.id,
              buildingName: b.name,
              roomNo: rNo,
              floor: extractFloor(rNo),
              waterType: b.waterType,
              waterRate: b.waterRate,
              waterNote: 'คิดตามหน่วย 20 บ./หน่วย'
            });
          });
        }
      });

      return allRooms;
    }

    const { createApp } = Vue;

    createApp({
      data() {
        const now = new Date();
        const yyyy = now.getFullYear();
        const mm = String(now.getMonth() + 1).padStart(2, '0');
        const defaultMonth = `${yyyy}-${mm}`;

        return {
          currentTab: 'buildingSheet', // 'grid', 'walkthrough', 'buildingSheet', 'monthlyReport', 'reports', 'sheets', 'settings'
          selectedMonth: defaultMonth,
          masterRooms: generateMasterRooms(),
          records: {}, // Keyed by month -> { roomId: recordData }
          
          // Filters
          selectedBuildingFilter: 'ALL',
          selectedFloorFilter: 'ALL',
          selectedStatusFilter: 'ALL',
          searchQuery: '',
          reportBuildingFilter: 'ALL',
          
          // Building Sheet Selected Building
          sheetSelectedBuilding: 'thachana',

          // Walkthrough Mode State
          walkthroughBuilding: 'ALL',
          walkthroughStatusFilter: 'PENDING',
          currentWalkIndex: 0,
          walkForm: {
            waterPrev: 0,
            waterCurr: 0,
            occupants: 1,
            elecPrev: 0,
            elecCurr: 0,
            remark: '',
            waterPhoto: null,
            elecPhoto: null
          },

          // Settings
          settings: {
            defaultElecRate: 7,
            defaultWaterRate: 20,
            defaultFlatWaterRate: 100
          },

          // Single Record Modal
          modalRecord: {
            show: false,
            room: null,
            form: {
              waterPrev: 0,
              waterCurr: 0,
              occupants: 1,
              elecPrev: 0,
              elecCurr: 0,
              remark: '',
              waterPhoto: null,
              elecPhoto: null
            }
          },

          // Single Invoice Modal
          modalInvoice: {
            show: false,
            record: null
          },

          // Selection for batch printing
          selectedRoomIdsForPrint: [],
          printableRecords: [],

          // Toast
          toast: {
            show: false,
            message: '',
            type: 'success'
          }
        };
      },

      computed: {
        buildingList() {
          return BUILDINGS_CONFIG.map(b => ({ id: b.id, name: b.name }));
        },

        currentMonthRecords() {
          return this.records[this.selectedMonth] || {};
        },

        monthRecordsArray() {
          return Object.values(this.currentMonthRecords);
        },

        currentSheetBuilding() {
          return BUILDINGS_CONFIG.find(b => b.id === this.sheetSelectedBuilding) || BUILDINGS_CONFIG[0];
        },

        // Building Meter Sheet Rows for Table Format
        currentBuildingSheetRows() {
          const rooms = this.masterRooms.filter(r => r.buildingId === this.sheetSelectedBuilding);
          
          return rooms.map(room => {
            const rec = this.getRecord(room.id);
            const prevRec = this.getPreviousMonthRecord(room.id);

            return {
              roomId: room.id,
              roomNo: room.roomNo,
              waterType: room.waterType,
              hasRecord: !!rec,

              waterPrev: rec ? rec.waterPrev : (prevRec ? prevRec.waterCurr : 0),
              waterCurr: rec ? rec.waterCurr : 0,
              waterUnits: rec ? rec.waterUnits : 0,
              waterCost: rec ? rec.waterCost : 0,
              occupants: rec ? rec.occupants : 1,

              elecPrev: rec ? rec.elecPrev : (prevRec ? prevRec.elecCurr : 0),
              elecCurr: rec ? rec.elecCurr : 0,
              elecUnits: rec ? rec.elecUnits : 0,
              elecCost: rec ? rec.elecCost : 0,

              totalAmount: rec ? rec.totalAmount : 0,
              remark: rec ? (rec.remark || '') : ''
            };
          });
        },

        currentSheetTotals() {
          const rows = this.currentBuildingSheetRows;
          return {
            waterUnits: rows.reduce((sum, r) => sum + (r.waterUnits || 0), 0),
            elecUnits: rows.reduce((sum, r) => sum + (r.elecUnits || 0), 0),
            waterCost: rows.reduce((sum, r) => sum + (r.waterCost || 0), 0),
            elecCost: rows.reduce((sum, r) => sum + (r.elecCost || 0), 0),
            totalAmount: rows.reduce((sum, r) => sum + (r.totalAmount || 0), 0)
          };
        },

        stats() {
          const totalRooms = this.masterRooms.length;
          const monthRecs = Object.values(this.currentMonthRecords);
          const recordedCount = monthRecs.length;
          const totalRevenue = monthRecs.reduce((sum, r) => sum + (r.totalAmount || 0), 0);

          return {
            totalRooms,
            recordedCount,
            totalRevenue
          };
        },

        // Monthly Summary Analytics
        monthlyAnalytics() {
          const monthRecs = Object.values(this.currentMonthRecords);
          const totalRev = monthRecs.reduce((sum, r) => sum + (r.totalAmount || 0), 0);
          const waterRev = monthRecs.reduce((sum, r) => sum + (r.waterCost || 0), 0);
          const elecRev = monthRecs.reduce((sum, r) => sum + (r.elecCost || 0), 0);
          const wUnits = monthRecs.reduce((sum, r) => sum + (r.waterUnits || 0), 0);
          const eUnits = monthRecs.reduce((sum, r) => sum + (r.elecUnits || 0), 0);

          const totalRooms = this.masterRooms.length;
          const recordedCount = monthRecs.length;
          const completionPercentage = totalRooms > 0 ? ((recordedCount / totalRooms) * 100).toFixed(1) : 0;
          const avgPerRoom = recordedCount > 0 ? (totalRev / recordedCount) : 0;

          return {
            totalRevenue: totalRev,
            waterRevenue: waterRev,
            elecRevenue: elecRev,
            waterUnits: wUnits,
            elecUnits: eUnits,
            completionPercentage,
            avgPerRoom
          };
        },

        monthlyBuildingStats() {
          return BUILDINGS_CONFIG.map(b => {
            const bRooms = this.masterRooms.filter(r => r.buildingId === b.id);
            const total = bRooms.length;
            
            let recorded = 0;
            let waterUnits = 0;
            let waterCost = 0;
            let elecUnits = 0;
            let elecCost = 0;
            let totalCost = 0;

            bRooms.forEach(room => {
              const rec = this.getRecord(room.id);
              if (rec) {
                recorded++;
                waterUnits += (rec.waterUnits || 0);
                waterCost += (rec.waterCost || 0);
                elecUnits += (rec.elecUnits || 0);
                elecCost += (rec.elecCost || 0);
                totalCost += (rec.totalAmount || 0);
              }
            });

            return {
              id: b.id,
              name: b.name,
              total,
              recorded,
              waterUnits,
              waterCost,
              elecUnits,
              elecCost,
              totalCost
            };
          });
        },

        groupedFilteredRooms() {
          let rooms = [...this.masterRooms];

          if (this.selectedBuildingFilter !== 'ALL') {
            rooms = rooms.filter(r => r.buildingId === this.selectedBuildingFilter);
          }

          if (this.selectedFloorFilter !== 'ALL') {
            rooms = rooms.filter(r => r.floor === Number(this.selectedFloorFilter));
          }

          if (this.selectedStatusFilter === 'RECORDED') {
            rooms = rooms.filter(r => !!this.getRecord(r.id));
          } else if (this.selectedStatusFilter === 'PENDING') {
            rooms = rooms.filter(r => !this.getRecord(r.id));
          }

          if (this.searchQuery.trim()) {
            const q = this.searchQuery.trim().toLowerCase();
            rooms = rooms.filter(r => r.roomNo.toLowerCase().includes(q) || r.buildingName.toLowerCase().includes(q));
          }

          const groups = {};
          rooms.forEach(r => {
            if (!groups[r.buildingId]) {
              groups[r.buildingId] = {
                buildingId: r.buildingId,
                buildingName: r.buildingName,
                waterNote: r.waterNote,
                rooms: []
              };
            }
            groups[r.buildingId].rooms.push(r);
          });

          return Object.values(groups);
        },

        pendingRoomsList() {
          let rooms = [...this.masterRooms];
          if (this.walkthroughBuilding !== 'ALL') {
            rooms = rooms.filter(r => r.buildingId === this.walkthroughBuilding);
          }
          if (this.walkthroughStatusFilter === 'PENDING') {
            rooms = rooms.filter(r => !this.getRecord(r.id));
          }
          return rooms;
        },

        currentWalkRoom() {
          if (this.pendingRoomsList.length === 0) return null;
          if (this.currentWalkIndex >= this.pendingRoomsList.length) {
            this.currentWalkIndex = 0;
          }
          return this.pendingRoomsList[this.currentWalkIndex];
        },

        walkWaterUnits() {
          if (!this.currentWalkRoom || this.currentWalkRoom.waterType === 'flat_per_person') return 0;
          return Math.max(0, (this.walkForm.waterCurr || 0) - (this.walkForm.waterPrev || 0));
        },
        walkWaterCost() {
          if (!this.currentWalkRoom) return 0;
          if (this.currentWalkRoom.waterType === 'flat_per_person') {
            return (this.walkForm.occupants || 0) * (this.settings.defaultFlatWaterRate || 100);
          }
          return this.walkWaterUnits * (this.settings.defaultWaterRate || 20);
        },
        walkElecUnits() {
          return Math.max(0, (this.walkForm.elecCurr || 0) - (this.walkForm.elecPrev || 0));
        },
        walkElecCost() {
          return this.walkElecUnits * (this.settings.defaultElecRate || 7);
        },
        walkTotalAmount() {
          return this.walkWaterCost + this.walkElecCost;
        },

        modalWaterUnits() {
          if (!this.modalRecord.room || this.modalRecord.room.waterType === 'flat_per_person') return 0;
          return Math.max(0, (this.modalRecord.form.waterCurr || 0) - (this.modalRecord.form.waterPrev || 0));
        },
        modalWaterCost() {
          if (!this.modalRecord.room) return 0;
          if (this.modalRecord.room.waterType === 'flat_per_person') {
            return (this.modalRecord.form.occupants || 0) * (this.settings.defaultFlatWaterRate || 100);
          }
          return this.modalWaterUnits * (this.settings.defaultWaterRate || 20);
        },
        modalElecUnits() {
          return Math.max(0, (this.modalRecord.form.elecCurr || 0) - (this.modalRecord.form.elecPrev || 0));
        },
        modalElecCost() {
          return this.modalElecUnits * (this.settings.defaultElecRate || 7);
        },
        modalTotalAmount() {
          return this.modalWaterCost + this.modalElecCost;
        },

        filteredReportRecords() {
          let list = Object.values(this.currentMonthRecords);
          if (this.reportBuildingFilter !== 'ALL') {
            list = list.filter(r => r.buildingId === this.reportBuildingFilter);
          }
          return list;
        },

        isAllSelectedForPrint() {
          return this.filteredReportRecords.length > 0 && 
                 this.selectedRoomIdsForPrint.length === this.filteredReportRecords.length;
        }
      },

      watch: {
        currentWalkRoom: {
          immediate: true,
          handler(newRoom) {
            if (newRoom) {
              const rec = this.getRecord(newRoom.id);
              const prevRec = this.getPreviousMonthRecord(newRoom.id);

              this.walkForm.waterPrev = rec ? rec.waterPrev : (prevRec ? prevRec.waterCurr : 0);
              this.walkForm.waterCurr = rec ? rec.waterCurr : (prevRec ? prevRec.waterCurr : 0);
              this.walkForm.occupants = rec ? (rec.occupants || 1) : 1;

              this.walkForm.elecPrev = rec ? rec.elecPrev : (prevRec ? prevRec.elecCurr : 0);
              this.walkForm.elecCurr = rec ? rec.elecCurr : (prevRec ? prevRec.elecCurr : 0);
              this.walkForm.remark = rec ? (rec.remark || '') : '';

              this.walkForm.waterPhoto = rec ? rec.waterPhoto : null;
              this.walkForm.elecPhoto = rec ? rec.elecPhoto : null;
            }
          }
        }
      },

      created() {
        this.loadSettings();
        this.loadDatabase();
        // Seed sample data if empty so user immediately sees the report filled
        if (Object.keys(this.currentMonthRecords).length === 0) {
          this.seedSampleData();
        }
      },

      methods: {
        // Image Compression & Photo Handling
        onPhotoSelected(event, mode, meterType) {
          const file = event.target.files[0];
          if (!file) return;

          this.compressImage(file, (base64Img) => {
            if (mode === 'walk') {
              if (meterType === 'water') this.walkForm.waterPhoto = base64Img;
              if (meterType === 'elec') this.walkForm.elecPhoto = base64Img;
            } else if (mode === 'modal') {
              if (meterType === 'water') this.modalRecord.form.waterPhoto = base64Img;
              if (meterType === 'elec') this.modalRecord.form.elecPhoto = base64Img;
            }
          });
        },

        compressImage(file, callback) {
          const reader = new FileReader();
          reader.readAsDataURL(file);
          reader.onload = (e) => {
            const img = new Image();
            img.src = e.target.result;
            img.onload = () => {
              const canvas = document.createElement('canvas');
              const MAX_WIDTH = 500;
              const scaleSize = MAX_WIDTH / img.width;
              if (scaleSize < 1) {
                canvas.width = MAX_WIDTH;
                canvas.height = img.height * scaleSize;
              } else {
                canvas.width = img.width;
                canvas.height = img.height;
              }
              const ctx = canvas.getContext('2d');
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
              callback(canvas.toDataURL('image/jpeg', 0.6));
            };
          };
        },

        printBuildingSheet() {
          window.print();
        },

        printMonthlySummary() {
          window.print();
        },

        // Data Persistence
        loadSettings() {
          const s = localStorage.getItem('meter_settings');
          if (s) {
            try { this.settings = JSON.parse(s); } catch (e) {}
          }
        },
        saveSettings() {
          localStorage.setItem('meter_settings', JSON.stringify(this.settings));
          this.showToast('บันทึกการตั้งค่าเรียบร้อยแล้ว');
        },

        loadDatabase() {
          const db = localStorage.getItem('meter_records_db');
          if (db) {
            try { this.records = JSON.parse(db); } catch (e) { this.records = {}; }
          }
        },
        saveDatabase() {
          localStorage.setItem('meter_records_db', JSON.stringify(this.records));
        },

        getRecord(roomId) {
          return this.currentMonthRecords[roomId] || null;
        },

        getPreviousMonthRecord(roomId) {
          const [year, month] = this.selectedMonth.split('-').map(Number);
          let prevY = year;
          let prevM = month - 1;
          if (prevM < 1) {
            prevM = 12;
            prevY--;
          }
          const prevKey = `${prevY}-${String(prevM).padStart(2, '0')}`;
          return (this.records[prevKey] && this.records[prevKey][roomId]) ? this.records[prevKey][roomId] : null;
        },

        updateRoomRemark(roomId, newRemark) {
          if (!this.records[this.selectedMonth]) {
            this.records[this.selectedMonth] = {};
          }
          if (this.records[this.selectedMonth][roomId]) {
            this.records[this.selectedMonth][roomId].remark = newRemark;
            this.saveDatabase();
          }
        },

        getBuildingRecordedCount(bId) {
          const bRooms = this.masterRooms.filter(r => r.buildingId === bId);
          return bRooms.filter(r => !!this.getRecord(r.id)).length;
        },

        getBuildingTotalRooms(bId) {
          return this.masterRooms.filter(r => r.buildingId === bId).length;
        },

        onMonthChange() {
          this.selectedRoomIdsForPrint = [];
        },

        // Single Record Modal Handlers
        openRecordModal(room) {
          this.modalRecord.room = room;
          const rec = this.getRecord(room.id);
          const prevRec = this.getPreviousMonthRecord(room.id);

          this.modalRecord.form = {
            waterPrev: rec ? rec.waterPrev : (prevRec ? prevRec.waterCurr : 0),
            waterCurr: rec ? rec.waterCurr : (prevRec ? prevRec.waterCurr : 0),
            occupants: rec ? (rec.occupants || 1) : 1,
            elecPrev: rec ? rec.elecPrev : (prevRec ? prevRec.elecCurr : 0),
            elecCurr: rec ? rec.elecCurr : (prevRec ? prevRec.elecCurr : 0),
            remark: rec ? (rec.remark || '') : '',
            waterPhoto: rec ? rec.waterPhoto : null,
            elecPhoto: rec ? rec.elecPhoto : null
          };

          this.modalRecord.show = true;
        },

        closeRecordModal() {
          this.modalRecord.show = false;
        },

        saveSingleRecord() {
          const room = this.modalRecord.room;
          if (!room) return;

          const recData = {
            roomId: room.id,
            buildingId: room.buildingId,
            buildingName: room.buildingName,
            roomNo: room.roomNo,
            floor: room.floor,
            waterType: room.waterType,
            
            waterPrev: this.modalRecord.form.waterPrev || 0,
            waterCurr: this.modalRecord.form.waterCurr || 0,
            occupants: this.modalRecord.form.occupants || 1,
            waterUnits: this.modalWaterUnits,
            waterCost: this.modalWaterCost,
            waterPhoto: this.modalRecord.form.waterPhoto || null,

            elecPrev: this.modalRecord.form.elecPrev || 0,
            elecCurr: this.modalRecord.form.elecCurr || 0,
            elecUnits: this.modalElecUnits,
            elecCost: this.modalElecCost,
            elecPhoto: this.modalRecord.form.elecPhoto || null,

            remark: this.modalRecord.form.remark || '',
            totalAmount: this.modalTotalAmount,
            recordedAt: new Date().toISOString()
          };

          if (!this.records[this.selectedMonth]) {
            this.records[this.selectedMonth] = {};
          }

          this.records[this.selectedMonth][room.id] = recData;
          this.saveDatabase();

          this.showToast(`บันทึกมิเตอร์ ห้อง ${room.roomNo} เรียบร้อยแล้ว`);
          this.closeRecordModal();
        },

        openQuickWalkthrough() {
          this.currentTab = 'walkthrough';
          this.currentWalkIndex = 0;
        },

        resetWalkthrough() {
          this.currentWalkIndex = 0;
        },

        prevWalkRoom() {
          if (this.currentWalkIndex > 0) {
            this.currentWalkIndex--;
          }
        },

        skipWalkRoom() {
          if (this.currentWalkIndex < this.pendingRoomsList.length - 1) {
            this.currentWalkIndex++;
          } else {
            this.currentWalkIndex = 0;
          }
        },

        saveAndNextWalk() {
          const room = this.currentWalkRoom;
          if (!room) return;

          const recData = {
            roomId: room.id,
            buildingId: room.buildingId,
            buildingName: room.buildingName,
            roomNo: room.roomNo,
            floor: room.floor,
            waterType: room.waterType,

            waterPrev: this.walkForm.waterPrev || 0,
            waterCurr: this.walkForm.waterCurr || 0,
            occupants: this.walkForm.occupants || 1,
            waterUnits: this.walkWaterUnits,
            waterCost: this.walkWaterCost,
            waterPhoto: this.walkForm.waterPhoto || null,

            elecPrev: this.walkForm.elecPrev || 0,
            elecCurr: this.walkForm.elecCurr || 0,
            elecUnits: this.walkElecUnits,
            elecCost: this.walkElecCost,
            elecPhoto: this.walkForm.elecPhoto || null,

            remark: this.walkForm.remark || '',
            totalAmount: this.walkTotalAmount,
            recordedAt: new Date().toISOString()
          };

          if (!this.records[this.selectedMonth]) {
            this.records[this.selectedMonth] = {};
          }

          this.records[this.selectedMonth][room.id] = recData;
          this.saveDatabase();

          this.showToast(`บันทึกมิเตอร์ ห้อง ${room.roomNo} สำเร็จ`);

          if (this.pendingRoomsList.length > 1) {
            if (this.walkthroughStatusFilter === 'PENDING') {
              this.currentWalkIndex = 0;
            } else {
              this.currentWalkIndex++;
            }
          }
        },

        openSingleInvoiceModal(rec) {
          this.modalInvoice.record = rec;
          this.modalInvoice.show = true;
        },

        printSingleInvoice() {
          this.printableRecords = [this.modalInvoice.record];
          this.$nextTick(() => {
            window.print();
          });
        },

        toggleSelectAllForPrint(e) {
          if (e.target.checked) {
            this.selectedRoomIdsForPrint = this.filteredReportRecords.map(r => r.roomId);
          } else {
            this.selectedRoomIdsForPrint = [];
          }
        },

        printAllSelectedPDF() {
          if (this.selectedRoomIdsForPrint.length === 0) return;
          this.printableRecords = this.filteredReportRecords.filter(r => this.selectedRoomIdsForPrint.includes(r.roomId));
          this.$nextTick(() => {
            window.print();
          });
        },

        downloadCSV() {
          const list = this.monthRecordsArray;
          if (list.length === 0) {
            this.showToast('ไม่มีข้อมูลสำหรับส่งออกในเดือนนี้', 'error');
            return;
          }

          let csv = "\uFEFF"; // UTF-8 BOM
          csv += "เดือน,อาคาร,เลขห้อง,ชั้น,ประเภทค่าน้ำ,มิเตอร์น้ำเดิม,มิเตอร์น้ำใหม่/คน,หน่วยน้ำ,ค่าน้ำ(บาท),มิเตอร์ไฟเดิม,มิเตอร์ไฟใหม่,หน่วยไฟฟ้า,ค่าไฟฟ้า(บาท),รวมทั้งสิ้น(บาท),หมายเหตุ\n";

          list.forEach(r => {
            const wVal = r.waterType === 'flat_per_person' ? `${r.occupants} คน` : r.waterCurr;
            csv += `"${this.selectedMonth}","${r.buildingName}","${r.roomNo}","${r.floor}","${r.waterType}","${r.waterPrev}","${wVal}","${r.waterUnits}","${r.waterCost}","${r.elecPrev}","${r.elecCurr}","${r.elecUnits}","${r.elecCost}","${r.totalAmount}","${r.remark || ''}"\n`;
          });

          const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.setAttribute("download", `รายงานมิเตอร์_${this.selectedMonth}.csv`);
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);

          this.showToast('ดาวน์โหลดไฟล์ CSV เรียบร้อยแล้ว');
        },

        copyForGoogleSheets() {
          const list = this.monthRecordsArray;
          if (list.length === 0) {
            this.showToast('ไม่มีข้อมูลสำหรับคัดลอกในเดือนนี้', 'error');
            return;
          }

          let tsv = "เดือน\tอาคาร\tเลขห้อง\tชั้น\tประเภทค่าน้ำ\tมิเตอร์น้ำเดิม\tมิเตอร์น้ำใหม่/คน\tหน่วยน้ำ\tค่าน้ำ(บาท)\tมิเตอร์ไฟเดิม\tมิเตอร์ไฟใหม่\tหน่วยไฟฟ้า\tค่าไฟฟ้า(บาท)\tรวมทั้งสิ้น(บาท)\tหมายเหตุ\n";

          list.forEach(r => {
            const wVal = r.waterType === 'flat_per_person' ? `${r.occupants} คน` : r.waterCurr;
            tsv += `${this.selectedMonth}\t${r.buildingName}\t${r.roomNo}\t${r.floor}\t${r.waterType}\t${r.waterPrev}\t${wVal}\t${r.waterUnits}\t${r.waterCost}\t${r.elecPrev}\t${r.elecCurr}\t${r.elecUnits}\t${r.elecCost}\t${r.totalAmount}\t${r.remark || ''}\n`;
          });

          const textarea = document.createElement("textarea");
          textarea.value = tsv;
          document.body.appendChild(textarea);
          textarea.select();
          document.execCommand('copy');
          document.body.removeChild(textarea);

          this.showToast('คัดลอกข้อมูลลง Clipboard แล้ว! กด Ctrl+V ใน Google Sheets ได้ทันที');
        },

        // Sample Seed Data matching user's image (Thachana, football players, zero usage etc.)
        seedSampleData() {
          if (!this.records[this.selectedMonth]) {
            this.records[this.selectedMonth] = {};
          }

          this.masterRooms.forEach(room => {
            let baseWater = Math.floor(Math.random() * 200) + 800;
            let waterUsed = Math.floor(Math.random() * 12) + 1;
            let occupants = Math.floor(Math.random() * 2) + 1;

            let baseElec = Math.floor(Math.random() * 1000) + 6000;
            let elecUsed = Math.floor(Math.random() * 150) + 40;
            let remark = '';

            // Simulate specific data matching image for Thachana rooms 103-110 (Football team zero usage)
            if (room.buildingId === 'thachana' && parseInt(room.roomNo) >= 103 && parseInt(room.roomNo) <= 110) {
              waterUsed = 0;
              elecUsed = 0;
              remark = 'นักฟุตบอล';
            }

            const isFlat = room.waterType === 'flat_per_person';
            const wCost = isFlat ? (occupants * 100) : (waterUsed * 20);
            const eCost = elecUsed * 6; // Standard elec rate

            this.records[this.selectedMonth][room.id] = {
              roomId: room.id,
              buildingId: room.buildingId,
              buildingName: room.buildingName,
              roomNo: room.roomNo,
              floor: room.floor,
              waterType: room.waterType,

              waterPrev: baseWater,
              waterCurr: isFlat ? baseWater : (baseWater + waterUsed),
              occupants: occupants,
              waterUnits: isFlat ? 0 : waterUsed,
              waterCost: wCost,

              elecPrev: baseElec,
              elecCurr: baseElec + elecUsed,
              elecUnits: elecUsed,
              elecCost: eCost,

              remark: remark,
              totalAmount: wCost + eCost,
              recordedAt: new Date().toISOString()
            };
          });

          this.saveDatabase();
          this.showToast('สร้างข้อมูลตัวอย่างสุ่มหอพักเรียบร้อยแล้ว!');
        },

        exportBackupJSON() {
          const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(this.records, null, 2));
          const dlAnchorElem = document.createElement('a');
          dlAnchorElem.setAttribute("href", dataStr);
          dlAnchorElem.setAttribute("download", `meter_db_backup_${new Date().toISOString().slice(0,10)}.json`);
          dlAnchorElem.click();
          this.showToast('สำรองข้อมูล JSON เรียบร้อย');
        },

        confirmClearMonth() {
          if (this.records[this.selectedMonth]) {
            delete this.records[this.selectedMonth];
            this.saveDatabase();
            this.showToast(`ล้างข้อมูลเดือน ${this.selectedMonth} เรียบร้อยแล้ว`);
          }
        },

        // Short Thai Month Code (e.g., "ก.ย. 69", "ส.ค. 69")
        getShortMonthYear(yearMonthStr) {
          if (!yearMonthStr) return '';
          const [y, m] = yearMonthStr.split('-');
          const thaiShortMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
          const mIdx = parseInt(m, 10) - 1;
          const yearShort = (parseInt(y, 10) + 543).toString().slice(-2);
          return `${thaiShortMonths[mIdx]} ${yearShort}`;
        },

        getPrevShortMonthYear(yearMonthStr) {
          if (!yearMonthStr) return '';
          const [y, m] = yearMonthStr.split('-').map(Number);
          let prevY = y;
          let prevM = m - 1;
          if (prevM < 1) {
            prevM = 12;
            prevY--;
          }
          const thaiShortMonths = ['ม.ค.', 'ก.พ.', 'มี.ค.', 'เม.ย.', 'พ.ค.', 'มิ.ย.', 'ก.ค.', 'ส.ค.', 'ก.ย.', 'ต.ค.', 'พ.ย.', 'ธ.ค.'];
          const yearShort = (prevY + 543).toString().slice(-2);
          return `${thaiShortMonths[prevM - 1]} ${yearShort}`;
        },

        formatNumber(num) {
          return (num || 0).toLocaleString('th-TH', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        },

        formatMonthThai(yearMonthStr) {
          if (!yearMonthStr) return '';
          const [y, m] = yearMonthStr.split('-');
          const thaiMonths = [
            'มกราคม', 'กุมภาพันธ์', 'มีนาคม', 'เมษายน', 'พฤษภาคม', 'มิถุนายน',
            'กรกฎาคม', 'สิงหาคม', 'กันยายน', 'ตุลาคม', 'พฤศจิกายน', 'ธันวาคม'
          ];
          const mIdx = parseInt(m, 10) - 1;
          const thaiYear = parseInt(y, 10) + 543;
          return `${thaiMonths[mIdx]} ${thaiYear}`;
        },

        showToast(msg, type = 'success') {
          this.toast.message = msg;
          this.toast.type = type;
          this.toast.show = true;
          setTimeout(() => {
            this.toast.show = false;
          }, 3000);
        }
      }
    }).mount('#app');
  </script>

