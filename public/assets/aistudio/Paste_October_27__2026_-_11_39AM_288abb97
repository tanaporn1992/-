<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบจดมิเตอร์น้ำประปาและมิเตอร์ไฟฟ้า - Dorm Utility System</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts (Prompt & Sarabun for clean Thai typography) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&family=Sarabun:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  
  <!-- Vue 3 CDN -->
  <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

  <!-- html2pdf.js for PDF Generation -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

  <style>
    body {
      font-family: 'Prompt', 'Sarabun', sans-serif;
      background-color: #f3f4f6;
    }
    
    @media print {
      .no-print {
        display: none !important;
      }
      .print-only {
        display: block !important;
      }
      body {
        background-color: white !important;
        font-family: 'Sarabun', sans-serif !important;
        color: black !important;
      }
      .page-break {
        page-break-after: always;
      }
      @page {
        size: A4 portrait;
        margin: 1cm;
      }
    }

    .print-only {
      display: none;
    }

    /* Print Table Borders */
    .print-table, .print-table th, .print-table td {
      border: 1px solid #000000 !important;
      border-collapse: collapse !important;
    }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }
  </style>
</head>
<body class="text-slate-800 antialiased min-h-screen">

  <div id="app" class="flex flex-col min-h-screen">
    
    <!-- Toast Notification Popup -->
    <div v-if="toast.show" 
         :class="toast.type === 'success' ? 'bg-emerald-600' : 'bg-rose-600'" 
         class="fixed bottom-5 right-5 z-50 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all transform duration-300">
      <i :class="toast.type === 'success' ? 'fa-check-circle' : 'fa-exclamation-triangle'" class="fas text-xl"></i>
      <span class="font-medium text-sm">{{ toast.message }}</span>
    </div>

    <!-- MAIN HEADER (NO-PRINT) -->
    <header class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 text-white shadow-lg sticky top-0 z-30 no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
          
          <!-- Logo & Dorm Title -->
          <div class="flex items-center space-x-3">
            <div class="p-2.5 bg-blue-600/40 border border-blue-400/30 rounded-2xl backdrop-blur-md">
              <i class="fa-solid fa-bolt-lightning text-amber-400 text-2xl"></i>
            </div>
            <div>
              <h1 class="text-lg md:text-xl font-bold tracking-wide">ระบบจดมิเตอร์น้ำ-ไฟฟ้าและออกใบแจ้งหนี้</h1>
              <p class="text-xs text-blue-200">จัดการอาคารพักอาศัย 8 อาคาร (รวม 382 ห้อง)</p>
            </div>
          </div>

          <!-- Month Selector & Quick Stats Bar -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            <div class="bg-white/10 border border-white/10 rounded-xl p-1.5 flex items-center space-x-2 backdrop-blur-sm">
              <i class="fa-regular fa-calendar-alt text-blue-300 ml-2"></i>
              <label class="text-xs text-blue-200 hidden sm:inline">ประจำเดือน:</label>
              <input type="month" v-model="selectedMonth" @change="onMonthChange" 
                     class="bg-slate-800 text-white text-xs sm:text-sm font-semibold px-2 py-1 rounded-lg border border-slate-600 focus:outline-none focus:ring-2 focus:ring-blue-400">
            </div>

            <button @click="openQuickWalkthrough" 
                    class="bg-amber-500 hover:bg-amber-600 active:scale-95 text-slate-950 font-bold px-3 py-2 rounded-xl text-xs sm:text-sm flex items-center space-x-2 shadow-md transition-all">
              <i class="fa-solid fa-pen-to-square"></i>
              <span>จดมิเตอร์ด่วน</span>
            </button>
          </div>

        </div>

        <!-- Global Summary Chips -->
        <div class="mt-3 pt-3 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
          <div class="bg-white/5 px-3 py-1.5 rounded-lg flex items-center justify-between border border-white/5">
            <span class="text-blue-200">ห้องทั้งหมด</span>
            <span class="font-bold text-sm text-white">{{ stats.totalRooms }}</span>
          </div>
          <div class="bg-emerald-500/10 px-3 py-1.5 rounded-lg flex items-center justify-between border border-emerald-500/20">
            <span class="text-emerald-300">บันทึกแล้ว</span>
            <span class="font-bold text-sm text-emerald-400">{{ stats.recordedCount }} / {{ stats.totalRooms }}</span>
          </div>
          <div class="bg-amber-500/10 px-3 py-1.5 rounded-lg flex items-center justify-between border border-amber-500/20">
            <span class="text-amber-300">รอดำเนินการ</span>
            <span class="font-bold text-sm text-amber-400">{{ stats.totalRooms - stats.recordedCount }}</span>
          </div>
          <div class="bg-blue-500/10 px-3 py-1.5 rounded-lg flex items-center justify-between border border-blue-500/20">
            <span class="text-blue-300">ประเมินยอดรวม</span>
            <span class="font-bold text-sm text-blue-300">฿{{ formatNumber(stats.totalRevenue) }}</span>
          </div>
        </div>

      </div>

      <!-- Navigation Tabs -->
      <div class="bg-slate-900/80 backdrop-blur-md border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-2 sm:px-6 flex space-x-1 sm:space-x-2 overflow-x-auto text-xs sm:text-sm font-medium">
          <button @click="currentTab = 'grid'" 
                  :class="currentTab === 'grid' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-border-all"></i>
            <span>ผังห้องพัก</span>
          </button>

          <button @click="currentTab = 'walkthrough'" 
                  :class="currentTab === 'walkthrough' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-list-check"></i>
            <span>จดมิเตอร์ต่อเนื่อง</span>
          </button>

          <!-- NEW TAB: BUILDING METER SHEET (รูปตามเอกสาร) -->
          <button @click="currentTab = 'buildingSheet'" 
                  :class="currentTab === 'buildingSheet' ? 'bg-indigo-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-table-list"></i>
            <span>ตารางจดมิเตอร์รายอาคาร</span>
          </button>

          <button @click="currentTab = 'monthlyReport'" 
                  :class="currentTab === 'monthlyReport' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-chart-pie"></i>
            <span>รายงานสรุปภาพรวม</span>
          </button>

          <button @click="currentTab = 'reports'" 
                  :class="currentTab === 'reports' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-file-invoice-dollar"></i>
            <span>ใบแจ้งหนี้รายห้อง</span>
          </button>

          <button @click="currentTab = 'sheets'" 
                  :class="currentTab === 'sheets' ? 'bg-emerald-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-file-excel"></i>
            <span>ส่งออก Google Sheets</span>
          </button>

          <button @click="currentTab = 'settings'" 
                  :class="currentTab === 'settings' ? 'bg-blue-600 text-white shadow-md' : 'text-slate-300 hover:bg-slate-800 hover:text-white'" 
                  class="px-3 py-2.5 rounded-t-lg transition-all flex items-center space-x-2 whitespace-nowrap">
            <i class="fa-solid fa-gear"></i>
            <span>ตั้งค่า & สำรองข้อมูล</span>
          </button>
        </div>
      </div>
    </header>

    <!-- MAIN CONTENT CONTAINER (NO-PRINT) -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 no-print">

      <!-- TAB 1: ROOM GRID VIEW (ผังห้องพัก) -->
      <section v-if="currentTab === 'grid'" class="space-y-5">
        
        <!-- Controls & Filters Bar -->
        <div class="bg-white p-4 rounded-2xl shadow-sm border border-slate-200/80 space-y-4">
          
          <!-- Building Selector Tabs -->
          <div>
            <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">เลือกอาคาร:</label>
            <div class="flex flex-wrap gap-2">
              <button @click="selectedBuildingFilter = 'ALL'" 
                      :class="selectedBuildingFilter === 'ALL' ? 'bg-slate-900 text-white shadow-md' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'"
                      class="px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all">
                ทุกอาคาร (382)
              </button>
              
              <button v-for="b in buildingList" :key="b.id" 
                      @click="selectedBuildingFilter = b.id"
                      :class="selectedBuildingFilter === b.id ? 'bg-blue-600 text-white shadow-md' : 'bg-slate-100 text-slate-700 hover:bg-slate-200'"
                      class="px-3 py-1.5 rounded-xl text-xs sm:text-sm font-medium transition-all flex items-center space-x-1">
                <span>{{ b.name }}</span>
                <span class="text-[10px] opacity-80 px-1.5 py-0.5 rounded-full bg-black/10">
                  {{ getBuildingRecordedCount(b.id) }}/{{ getBuildingTotalRooms(b.id) }}
                </span>
              </button>
            </div>
          </div>

          <!-- Secondary Filters: Floor & Status & Search -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-slate-100">
            <div>
              <label class="block text-xs text-slate-500 mb-1 font-medium">ชั้น:</label>
              <select v-model="selectedFloorFilter" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="ALL">ทุกชั้น</option>
                <option v-for="f in [1,2,3,4,5]" :key="f" :value="f">ชั้น {{ f }}</option>
              </select>
            </div>

            <div>
              <label class="block text-xs text-slate-500 mb-1 font-medium">สถานะบันทึก:</label>
              <select v-model="selectedStatusFilter" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <option value="ALL">ทั้งหมด</option>
                <option value="RECORDED">จดบันทึกแล้ว</option>
                <option value="PENDING">ยังไม่จดบันทึก</option>
              </select>
            </div>

            <div>
              <label class="block text-xs text-slate-500 mb-1 font-medium">ค้นหาเลขห้อง:</label>
              <div class="relative">
                <input type="text" v-model="searchQuery" placeholder="ระบุเลขห้อง เช่น 201, 4114..." 
                       class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
                <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-sm"></i>
              </div>
            </div>
          </div>

        </div>

        <!-- Room Cards Matrix -->
        <div class="space-y-6">
          <div v-for="bGroup in groupedFilteredRooms" :key="bGroup.buildingId" class="bg-white p-5 rounded-2xl shadow-sm border border-slate-200">
            
            <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
              <div class="flex items-center space-x-2">
                <div class="w-3 h-3 rounded-full bg-blue-600"></div>
                <h3 class="text-base font-bold text-slate-900">{{ bGroup.buildingName }}</h3>
                <span class="text-xs bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-full font-medium">
                  {{ bGroup.rooms.length }} ห้อง
                </span>
              </div>
              <span class="text-xs text-slate-500 font-medium">
                ค่าน้ำ: {{ bGroup.waterNote }}
              </span>
            </div>

            <!-- Room Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
              <div v-for="room in bGroup.rooms" :key="room.id" 
                   @click="openRecordModal(room)"
                   :class="[
                     getRecord(room.id) ? 'bg-emerald-50/70 border-emerald-300 hover:border-emerald-500' : 'bg-slate-50 border-slate-200 hover:border-blue-400',
                     'border rounded-xl p-3 cursor-pointer transition-all hover:shadow-md flex flex-col justify-between relative group'
                   ]">
                
                <div class="flex items-center justify-between mb-2">
                  <span class="font-extrabold text-slate-900 text-base sm:text-lg">
                    {{ room.roomNo }}
                  </span>
                  <span :class="getRecord(room.id) ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-600'" 
                        class="text-[10px] font-bold px-1.5 py-0.5 rounded-md">
                    {{ getRecord(room.id) ? 'จดแล้ว' : 'รอจด' }}
                  </span>
                </div>

                <div v-if="getRecord(room.id)" class="text-xs space-y-1 text-slate-600">
                  <div class="flex justify-between text-[11px]">
                    <span class="text-slate-400"><i class="fa-solid fa-droplet text-blue-500 mr-1"></i>น้ำ:</span>
                    <span class="font-medium text-slate-800">
                      {{ room.waterType === 'flat_per_person' ? getRecord(room.id).occupants + ' คน' : getRecord(room.id).waterUnits + ' หน่วย' }}
                    </span>
                  </div>
                  <div class="flex justify-between text-[11px]">
                    <span class="text-slate-400"><i class="fa-solid fa-bolt text-amber-500 mr-1"></i>ไฟ:</span>
                    <span class="font-medium text-slate-800">{{ getRecord(room.id).elecUnits }} หน่วย</span>
                  </div>
                  
                  <div v-if="getRecord(room.id).remark" class="text-[10px] text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded truncate">
                    <i class="fa-regular fa-comment mr-1"></i>{{ getRecord(room.id).remark }}
                  </div>

                  <div class="pt-1.5 border-t border-emerald-200/60 flex justify-between font-bold text-emerald-800 text-xs">
                    <span>รวม:</span>
                    <span>฿{{ formatNumber(getRecord(room.id).totalAmount) }}</span>
                  </div>
                </div>

                <div v-else class="text-xs text-slate-400 py-2 text-center border-t border-dashed border-slate-200">
                  <i class="fa-solid fa-plus-circle text-slate-300 text-lg group-hover:text-blue-500 transition-colors"></i>
                  <p class="text-[10px] mt-1 text-slate-400 group-hover:text-blue-600">กดเพื่อบันทึก</p>
                </div>

              </div>
            </div>

          </div>

          <div v-if="groupedFilteredRooms.length === 0" class="text-center py-16 bg-white rounded-2xl border border-slate-200">
            <i class="fa-solid fa-folder-open text-4xl text-slate-300 mb-3"></i>
            <p class="text-slate-500 font-medium">ไม่พบข้อมูลห้องพักตามเงื่อนไขที่เลือก</p>
          </div>
        </div>

      </section>

      <!-- TAB 2: CONTINUOUS METER RECORDING (จดมิเตอร์แบบต่อเนื่อง) -->
      <section v-if="currentTab === 'walkthrough'" class="max-w-3xl mx-auto space-y-6">
        
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
            <div>
              <h2 class="text-lg font-bold text-slate-900">โหมดจดมิเตอร์ต่อเนื่อง (Walkthrough Mode)</h2>
              <p class="text-xs text-slate-500">ช่วยให้เจ้าหน้าที่เดินจดมิเตอร์ทีละห้องได้อย่างสะดวก รวดเร็ว</p>
            </div>
            <span class="text-xs font-semibold px-3 py-1 bg-blue-50 text-blue-700 rounded-full">
              ห้องที่ {{ currentWalkIndex + 1 }} / {{ pendingRoomsList.length }}
            </span>
          </div>

          <!-- Select Building for Walkthrough -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">อาคารที่เดินจด:</label>
              <select v-model="walkthroughBuilding" @change="resetWalkthrough" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <option value="ALL">ทุกอาคาร</option>
                <option v-for="b in buildingList" :key="b.id" :value="b.id">{{ b.name }}</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">กรองสถานะห้อง:</label>
              <select v-model="walkthroughStatusFilter" @change="resetWalkthrough" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:ring-2 focus:ring-blue-500">
                <option value="PENDING">เฉพาะห้องที่ยังไม่ได้จด</option>
                <option value="ALL">ห้องทั้งหมดในอาคาร</option>
              </select>
            </div>
          </div>

          <!-- Current Walkthrough Active Room Card -->
          <div v-if="currentWalkRoom" class="bg-slate-50 border-2 border-blue-500/80 rounded-2xl p-5 space-y-5 shadow-sm">
            
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-blue-600 uppercase tracking-wide">{{ currentWalkRoom.buildingName }} • ชั้น {{ currentWalkRoom.floor }}</span>
                <h3 class="text-2xl font-black text-slate-900">ห้อง {{ currentWalkRoom.roomNo }}</h3>
              </div>
              <div class="text-right">
                <span :class="currentWalkRoom.waterType === 'flat_per_person' ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'" class="text-xs font-bold px-2.5 py-1 rounded-lg">
                  {{ currentWalkRoom.waterType === 'flat_per_person' ? 'เหมาค่าน้ำ 100 บ./คน' : 'ค่าน้ำตามหน่วย (20 บ./หน่วย)' }}
                </span>
              </div>
            </div>

            <!-- Form Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-2 border-t border-slate-200">
              
              <!-- WATER METER SECTION -->
              <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-3">
                <div class="flex items-center space-x-2 text-blue-600 font-bold text-sm">
                  <i class="fa-solid fa-droplet"></i>
                  <span>มิเตอร์น้ำประปา</span>
                </div>

                <template v-if="currentWalkRoom.waterType === 'unit'">
                  <div>
                    <label class="block text-xs text-slate-500 mb-1">เลขมิเตอร์น้ำเดิม ({{ getPrevShortMonthYear(selectedMonth) }}):</label>
                    <input type="number" v-model.number="walkForm.waterPrev" class="w-full bg-slate-100 border border-slate-200 rounded-lg px-3 py-1.5 text-sm font-semibold text-slate-700">
                  </div>
                  <div>
                    <label class="block text-xs text-slate-500 mb-1">เลขมิเตอร์น้ำปัจจุบัน ({{ getShortMonthYear(selectedMonth) }}):</label>
                    <input type="number" v-model.number="walkForm.waterCurr" 
                           ref="walkWaterInput"
                           class="w-full bg-white border-2 border-blue-400 rounded-lg px-3 py-2 text-base font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                  </div>
                  <div class="text-xs flex justify-between pt-1 border-t border-slate-100 text-slate-600 font-medium">
                    <span>ใช้ไป: <b class="text-blue-600">{{ walkWaterUnits }}</b> หน่วย</span>
                    <span>เป็นเงิน: <b class="text-blue-600">฿{{ formatNumber(walkWaterCost) }}</b></span>
                  </div>
                </template>

                <template v-else>
                  <div>
                    <label class="block text-xs text-slate-500 mb-1">จำนวนผู้พักอาศัย (คน):</label>
                    <input type="number" min="0" v-model.number="walkForm.occupants" 
                           class="w-full bg-white border-2 border-amber-400 rounded-lg px-3 py-2 text-base font-bold text-slate-900 focus:ring-2 focus:ring-amber-500 focus:outline-none">
                  </div>
                  <div class="text-xs flex justify-between pt-1 border-t border-slate-100 text-slate-600 font-medium">
                    <span>อัตรา: 100 บาท/คน</span>
                    <span>เป็นเงิน: <b class="text-amber-600">฿{{ formatNumber(walkWaterCost) }}</b></span>
                  </div>
                </template>

